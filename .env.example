# Copy to .env.local and fill in. .env*.local is gitignored.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The service-role key bypasses row-level security and
# is used only from server route handlers — never expose it to the browser and
# never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used to build confirm and unsubscribe
# links and to resolve Open Graph images. On Vercel this falls back to
# VERCEL_URL automatically, but set it in production so preview deploys do not
# mail out links pointing at themselves.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Optional. With no key, confirmation links are printed to the server console
# instead of sent, so the whole flow is testable without an email account.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or delivery will fail.
EMAIL_FROM="Pulse <hello@yourdomain.com>"
EMAIL_REPLY_TO=

# ── Admin ───────────────────────────────────────────────────────────────────
# Guards /admin and /api/admin/*. If either is unset the admin surface returns
# 503 rather than opening — it fails closed on purpose.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Privacy ─────────────────────────────────────────────────────────────────
# Random string. IP addresses are stored only as salted SHA-256 digests for
# rate limiting; without a salt those digests are reversible by brute force,
# since the IPv4 space is small enough to enumerate.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=
