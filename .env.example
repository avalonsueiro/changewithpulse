# Copy to .env.local and fill in. .env*.local is gitignored.

# NOTE: nothing here is prefixed with NEXT_PUBLIC_. Every value is read only on
# the server — the browser form posts to relative paths and needs no config at
# all — so none of it is inlined into the client bundle.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The service-role key bypasses row-level security and
# is used only from server route handlers. Never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin. A bare domain works; trailing slashes are stripped. Used to
# build confirm and unsubscribe links and to resolve Open Graph images. On
# Vercel this falls back to VERCEL_URL, but set it explicitly in production so
# preview deploys do not mail out links pointing at themselves.
SITE_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Optional. With no key, confirmation links are printed to the server console
# instead of sent, so the whole flow is testable without an email account.
RESEND_API_KEY=
# Must be on a domain verified at https://resend.com/domains, or delivery
# fails. Until one is verified, Resend only accepts onboarding@resend.dev,
# which delivers ONLY to your own account address — so every other signup
# silently never receives a confirmation and stays pending forever.
EMAIL_FROM="Pulse <founders@mail.changewithpulse.com>"
# Sending from the mail. subdomain isolates reputation, but that subdomain
# has no mailbox — its MX points at Resend, not Google Workspace. Without a
# reply-to, anyone hitting Reply writes into the void. Point this at a real
# inbox on the ROOT domain, which is where the Google MX lives.
EMAIL_REPLY_TO=founders@changewithpulse.com

# ── Admin ───────────────────────────────────────────────────────────────────
# Guards /admin and /api/admin/*. If either is unset the admin surface returns
# 503 rather than opening — it fails closed on purpose.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Privacy ─────────────────────────────────────────────────────────────────
# Random string. IP addresses are stored only as salted SHA-256 digests for
# rate limiting; without a salt those digests are reversible by brute force,
# since the IPv4 space is small enough to enumerate.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=
